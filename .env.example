# Frontend detection provider mode: browser | backend | hybrid
VITE_DETECTION_PROVIDER=backend

# Backend API root URL (must include trailing slash)
VITE_DETECTION_BACKEND_URL=http://localhost:8001/

# Backend detector model id (format: project_name/version_number)
VITE_DETECTION_BACKEND_MODEL=people_counterv0/1

# Backend-only environment variables should be set in the shell before starting uvicorn:
# export ROBOFLOW_API_KEY=your_provider_api_key
# export ROBOFLOW_MODEL_ID=people_counterv0/1
# export CV_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4173
